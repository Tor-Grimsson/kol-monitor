{
  "name": "kol-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "check:stages": "node scripts/check-stages.js",
    "check:inks": "node scripts/check-module-inks.mjs",
    "check:library-merge": "node scripts/check-library-merge.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "api:dev": "wrangler dev --config api/wrangler.toml --port 8787",
    "api:schema": "wrangler d1 execute kol-monitor --remote --file api/schema.sql --config api/wrangler.toml",
    "api:schema:local": "wrangler d1 execute kol-monitor --local --file api/schema.sql --config api/wrangler.toml",
    "api:deploy": "wrangler deploy --config api/wrangler.toml",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-previews": "node scripts/generate-previews.js",
    "generate-videos": "node scripts/generate-videos.js"
  },
  "dependencies": {
    "@kolkrabbi/kol-brand": "^0.1.3",
    "@kolkrabbi/kol-component": "^0.291.0",
    "@kolkrabbi/kol-framework": "^0.53.0",
    "@kolkrabbi/kol-hardware": "^0.5.0",
    "@kolkrabbi/kol-icons": "0.41.0",
    "@kolkrabbi/kol-media-client": "0.6.0",
    "@kolkrabbi/kol-shell": "0.75.0",
    "@kolkrabbi/kol-theme": "^0.180.0",
    "@tailwindcss/vite": "^4.3.3",
    "gsap": "^3.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "use-context-selector": "^2.0.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "puppeteer-core": "^25.7.0",
    "sharp": "^0.35.5",
    "vite": "^8.2.1",
    "wrangler": "^4.149.0"
  }
}
